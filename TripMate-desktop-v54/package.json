{
  "name": "tripmate-desktop",
  "version": "1.0.1",
  "description": "旅伴 TripMate Windows 桌面客户端",
  "author": "TripMate",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/desktop-check.cjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.55.0"
  },
  "build": {
    "appId": "com.tripmate.desktop",
    "productName": "TripMate",
    "artifactName": "TripMate-v54-Windows-${version}-Setup.${ext}",
    "extraResources": [{"from":"assets/icon.ico","to":"tripmate-icon-v54.ico"}],
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "旅伴 TripMate",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "runAfterFinish": true
    }
  }
}
