# Only the current, reviewed source components belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/PROJECT.json
!/AGENTS.md
!/TripMate.code-workspace

!/TripMate-desktop-v54/
/TripMate-desktop-v54/*
!/TripMate-desktop-v54/src/
!/TripMate-desktop-v54/scripts/
!/TripMate-desktop-v54/tests/
!/TripMate-desktop-v54/assets/
!/TripMate-desktop-v54/*.md
!/TripMate-desktop-v54/.gitignore
!/TripMate-desktop-v54/package.json
!/TripMate-desktop-v54/package-lock.json

!/TripMate-native-v52/
/TripMate-native-v52/*
!/TripMate-native-v52/src/
!/TripMate-native-v52/scripts/
!/TripMate-native-v52/assets/
!/TripMate-native-v52/*.md
!/TripMate-native-v52/*.ts
!/TripMate-native-v52/*.tsx
!/TripMate-native-v52/.gitignore
!/TripMate-native-v52/LICENSE
!/TripMate-native-v52/app.json
!/TripMate-native-v52/eas.json
!/TripMate-native-v52/tsconfig.json
!/TripMate-native-v52/package.json
!/TripMate-native-v52/package-lock.json

!/guest-v43/
/guest-v43/*
!/guest-v43/*.mjs
!/guest-v43/*.sh
!/guest-v43/*.html
!/guest-v43/*.md
!/guest-v43/*.txt

# Defense in depth inside the allowlisted source directories.
**/node_modules/
**/dist/
**/.expo/
**/.build-check/
**/test-results/
**/.test*/
**/*test-data*/
**/data/
**/.env
**/.env.*
**/*.log
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
**/*.p12
**/*.p8
**/*.jks
**/*.keystore
**/config.json
**/credentials.json
**/users.json
**/sessions.json
**/cookies*.json
**/cookies*.txt
**/*.apk
**/*.exe
**/*.zip
**/*.tsbuildinfo
